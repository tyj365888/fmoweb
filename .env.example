# ============================================================
# FMO 完整部署 环境变量模板（compose.yaml 使用）
# 用法：cp .env.example .env 并填写真实值。
# 敏感值（密码/密钥）请勿填写真实值提交到公开仓库。
# ============================================================

# ---------- SAS 服务器身份 ----------
# 服务器（FMO 台站）的公开身份，SAS 和 fmoweb 共用
SAS_SERVER_UID=                    # 服务器 UID
SAS_SERVER_CALLSIGN=               # 服务器呼号
SAS_MQTT_HOST=                     # 设备要连接的 MQTT 公开域名
SAS_MQTT_PORT=1883                 # MQTT 端口
SAS_CERT_FINGERPRINT=              # 服务器证书指纹

# ---------- EMQX 仪表盘 ----------
EMQX_DASHBOARD_USERNAME=admin      # 仪表盘用户名
EMQX_DASHBOARD_PASSWORD=           # 仪表盘密码

# ---------- fmoweb：MySQL 数据库（需外部 MySQL） ----------
# 网页软电台的账号/身份/语音记录都存在这个库
FMOWEB_MYSQL_HOST=                 # 数据库地址
FMOWEB_MYSQL_PORT=3306             # 数据库端口
FMOWEB_MYSQL_USER=fmo              # 数据库用户名
FMOWEB_MYSQL_PASSWORD=             # 数据库密码
FMOWEB_MYSQL_DB=fmo                # 数据库名

# ---------- fmoweb：EMQX 管理 API ----------
# 用于查询在线客户端 IP、拉黑、踢下线
FMOWEB_EMQX_API=http://emqx:18083/api/v5   # EMQX 仪表盘 API（容器内网）
FMOWEB_EMQX_USER=admin             # EMQX 仪表盘用户名
FMOWEB_EMQX_PASSWORD=              # EMQX 仪表盘密码

# ---------- fmoweb：服务器公开域名 ----------
# 网页客户端要连接的公开域名（可能与 SAS_MQTT_HOST 不同）
FMOWEB_SERVER_URL=                 # 服务器公开域名

# ---------- fmoweb：SMTP 邮件（忘记密码发验证码用） ----------
FMOWEB_SMTP_HOST=                  # SMTP 服务器地址
FMOWEB_SMTP_PORT=465               # 端口（465=SSL，587=STARTTLS）
FMOWEB_SMTP_USER=                  # SMTP 登录用户名
FMOWEB_SMTP_PASSWORD=              # SMTP 登录密码
FMOWEB_SMTP_FROM=                  # 发件人邮箱

# ---------- fmoweb：管理员联系方式 ----------
# 呼号未绑定邮箱、无法找回密码时提示联系管理员
FMOWEB_ADMIN_WECHAT=               # 管理员微信号
FMOWEB_ADMIN_PHONE=                # 管理员手机号
